DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agrimarket

PORT=5000
CLIENT_URL=http://localhost:5173

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# OpenAI-compatible Chat Completions. Keep the real key in server/.env only.
AI_BASE_URL=https://api.hcnsec.cn
AI_API_KEY=
# Set this to a model enabled by your provider/account.
AI_MODEL=DeepSeek-V4-Flash

# Used only by `npm run seed` to create test accounts
SEED_ADMIN_PASSWORD=Admin@123
SEED_FARMER_PASSWORD=Farmer@123
SEED_BUYER_PASSWORD=Buyer@123

# The provider may take up to a minute to answer.
AI_TIMEOUT_MS=90000
